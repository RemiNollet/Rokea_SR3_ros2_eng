# MoveL.srv - linear motion service

# Relative offsets x, y, z in meters
# Offset from the current pose; may be positive or negative
float64[3] offset

# Motion speed (recommended range: 0.01-1.0)
float32 velocity

---
bool success       # Whether execution succeeded
string message     # Status message

