# MoveC.srv - circular motion service

# Auxiliary-point relative offset (dx, dy, dz) from the current pose
float64[3] aux_offset

# End-point relative offset (dx, dy, dz) from the current pose
float64[3] target_offset

# Motion speed (recommended range: 0.01-1.0)
float32 velocity

---
bool success       # Whether execution succeeded
string message     # Status message
