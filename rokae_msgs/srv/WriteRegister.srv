# Write-register service
string register_name    # Register name
string data_type       # "float", "int16", "bool", or "bit"
uint8 index            # Index (used for a single-value write; ignored for batch write)
bool write_all         # true: write the whole array; false: write a single value

# Single-value fields (used when write_all=false)
float32 float_value
int16 int16_value
bool bool_value

# Batch-write fields (used when write_all=true)
float32[] float_values
int16[] int16_values
bool[] bool_values

---
bool success
string message
