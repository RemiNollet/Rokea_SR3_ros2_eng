# JogControl.srv
string space       # Reference frame: "world", "joint", "tool", "flange", "singularityAvoidMode", "baseParallelMode"
float64 rate       # Rate: 0.01 - 1
float64 step       # Step: Cartesian space (mm) or joint space (deg)
uint8 index        # Index: meaning depends on space
bool direction     # Direction: true = positive, false = negative
---
bool success
string message

#  /**
#     * @brief Start jogging the robot. Switch to manual mode first.
#     * @note After this call starts motion, you must call stop() to end jog even if the robot
#     *       has already stopped by itself; otherwise the robot stays in jog mode.
#     * @param[in] space Jog reference frame.
#     *     1) Tool/workpiece frames follow the same rules as setToolset();
#     *     2) Industrial 6-axis and xMateCR/SR 6-axis models support two singularity-avoidance
#     *        modes: JogOpt::singularityAvoidMode, JogOpt::baseParallelMode
#     *     3) CR 5-axis models support parallel-base jog: JogOpt::baseParallelMode
#     * @param[in] rate Rate in range 0.01 - 1
#     * @param[in] step Step size. Units: Cartesian mm | joint deg. Any value > 0 is accepted;
#     *             the robot stops by itself if it cannot continue jogging.
#     * @param[in] index Meaning depends on space:
#     *     1) World, base, flange, tool/workpiece frames:
#     *       a) 6-axis: 0~5 map to X, Y, Z, Rx, Ry, Rz. >5 is an external axis if present
#     *       b) 7-axis: 6 is the elbow joint, >6 is an external axis if present
#     *     2) Joint space: joint index, starting from 0
#     *     3) Singularity-avoidance / parallel-base modes:
#     *       a) 6-axis: 0~5 map to X, Y, Z, J4, Ry, J6
#     *       b) 5-axis: 0~4 map to X, Y, Z, Ry, J5
#     * @param[in] direction Meaning depends on space and index:
#     *     1) Singularity-avoidance J4: true = ±180°, false = 0°
#     *     2) Parallel-base J4 & Ry: true = ±180°, false = 0°
#     *     3) Otherwise: true = positive, false = negative
#     * @param[out] ec Error code
#     */

    #  world = 0, ///< world frame
    #  flange, ///< flange frame
    #  baseFrame, ///< base frame
    #  toolFrame, ///< tool frame
    #  wobjFrame, ///< workpiece frame
    #  jointSpace, ///< joint space
    #  singularityAvoidMode, ///< singularity avoidance (industrial 6-axis, xMateCR, xMateSR); locks joint 4
    #  baseParallelMode ///< parallel-base mode (xMateCR and xMateSR only)

# e.g. world frame, +Z 50 mm, 50% rate: startJog(JogOpt::world, 0.5, 50, 2, true, ec)
